// ===============================
// Prisma setup
// ===============================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================
// ENUMS
// ===============================

enum WaterSource {
  MUNICIPAL
  BOREWELL
  BOTH
}

enum PersonRelation {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentType {
  RENT
  ELECTRICITY
  WATER
  MAINTENANCE
  PENALTY
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}


// ===============================
// BUILDING STRUCTURE
// ===============================

model Building {
  id        Int      @id @default(autoincrement())
  name      String
  address   String

  ownerName  String
  ownerPhone String?
  ownerEmail String?

  hasLift           Boolean      @default(false)
  parkingSlots      Int?
  powerBackup       Boolean      @default(false)
  waterSource       WaterSource?
  securityAvailable Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  floors Floor[]
}

model Floor {
  id        Int      @id @default(autoincrement())
  name      String
  code      Int

  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  rooms Room[]

  @@unique([buildingId, code])
}

model Room {
  id         Int    @id @default(autoincrement())
  roomNumber String
  baseRent   Float

  floorId Int
  floor   Floor @relation(fields: [floorId], references: [id])

  isOccupied Boolean @default(false)
  maintenanceRequests MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  meter Meter?

  tenantRooms TenantRoom[]

  @@unique([floorId, roomNumber])
}

// ===============================
// TENANT & OCCUPANCY
// ===============================

model Tenant {

  id Int @id @default(autoincrement())

  fullName String
  phone String
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  persons Person[]
  tenantRooms TenantRoom[]
  invoices Invoice[]
  payments Payment[]
  maintenanceRequests MaintenanceRequest[]

}


model Person {
  id        Int            @id @default(autoincrement())
  fullName  String
  age       Int?
  relation  PersonRelation?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TenantRoom {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  startDate DateTime
  endDate   DateTime?

  agreedRent Float

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lease Lease?

  @@index([tenantId])
  @@index([roomId])
}

// ===============================
// LEASE SYSTEM
// ===============================

model Lease {

  id Int @id @default(autoincrement())

  tenantRoomId Int @unique
  tenantRoom TenantRoom @relation(fields: [tenantRoomId], references: [id])

  rentAmount Float
  depositAmount Float

  startDate DateTime
  endDate DateTime?

  status LeaseStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

}


// ===============================
// METER SYSTEM
// ===============================

model Meter {
  id Int @id @default(autoincrement())

  meterNumber String @unique

  roomId Int @unique
  room   Room @relation(fields: [roomId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  readings MeterReading[]
}

model MeterReading {
  id Int @id @default(autoincrement())

  meterId Int
  meter   Meter @relation(fields: [meterId], references: [id])

  reading Int
  readingDate DateTime

  createdAt DateTime @default(now())

  @@unique([meterId, readingDate])
}

// ===============================
// BILLING SYSTEM
// ===============================

model Invoice {

  id Int @id @default(autoincrement())

  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])

  leaseId Int
  lease Lease @relation(fields: [leaseId], references: [id])

  billingMonth Int
  billingYear Int

  dueDate DateTime

  subtotal Float
  totalAmount Float

  status InvoiceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]
  payments Payment[]

}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  description String
  amount      Float
  type        PaymentType
}

model Payment {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Float

  type PaymentType
  status PaymentStatus

  transactionId String?
  notes         String?

  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ===============================
// MAINTENANCE
// ===============================

model MaintenanceRequest {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  title       String
  description String

  status MaintenanceStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
