// ===============================
// Prisma setup
// ===============================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================
// ENUMS
// ===============================

enum WaterSource {
  MUNICIPAL
  BOREWELL
  BOTH
}

enum PersonRelation {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

enum OccupancyType {
  SINGLE
  SHARED
  FAMILY
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentType {
  RENT
  ELECTRICITY
  WATER
  MAINTENANCE
  PENALTY
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

enum UserRole {
  OWNER
  MANAGER
  TENANT
}

enum MeterType {
  ELECTRICITY
  WATER
}

// ===============================
// MULTI TENANT (SaaS CORE)
// ===============================

model Organization {
  id        Int      @id @default(autoincrement())
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  tenants Tenant[]
  buildings Building[]

  @@index([name])
}

// ===============================
// USERS
// ===============================

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String

  role UserRole

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  tenantId Int? @unique
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ===============================
// BUILDING STRUCTURE
// ===============================

model Building {
  id   Int    @id @default(autoincrement())
  name String
  address String

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  ownerName  String
  ownerPhone String?
  ownerEmail String?

  hasLift           Boolean      @default(false)
  parkingSlots      Int?
  powerBackup       Boolean      @default(false)
  waterSource       WaterSource?
  securityAvailable Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  floors Floor[]
  rooms  Room[]

  stats BuildingStats?

  @@index([organizationId])
}

model Floor {
  id   Int    @id @default(autoincrement())
  name String
  code Int

  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  rooms Room[]

  @@unique([buildingId, code])
  @@index([buildingId])
}

model Room {
  id         Int    @id @default(autoincrement())
  roomNumber String
  baseRent   Float

  floorId    Int
  buildingId Int

  floor    Floor    @relation(fields: [floorId], references: [id])
  building Building @relation(fields: [buildingId], references: [id])

  isOccupied Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenantRooms TenantRoom[]
  meters      Meter[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([floorId, roomNumber])
  @@index([buildingId])
  @@index([isOccupied])
}

// ===============================
// TENANT & OCCUPANCY
// ===============================

model Tenant {
  id Int @id @default(autoincrement())

  fullName String
  phone    String
  email    String?

  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id])
  user User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  persons Person[]
  tenantRooms TenantRoom[]
  invoices Invoice[]
  payments Payment[]
  maintenanceRequests MaintenanceRequest[]

  @@index([organizationId])
}

model Person {
  id       Int @id @default(autoincrement())
  fullName String
  age      Int?

  relation  PersonRelation
  isPrimary Boolean @default(false)

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model TenantRoom {
  id Int @id @default(autoincrement())

  tenantId Int
  roomId   Int
  buildingId Int

  tenant Tenant @relation(fields: [tenantId], references: [id])
  room   Room   @relation(fields: [roomId], references: [id])
  occupancyType OccupancyType

  startDate DateTime
  endDate   DateTime?

  agreedRent Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leases Lease[]

  @@index([tenantId])
  @@index([roomId, endDate])
  @@index([buildingId])
}

// ===============================
// LEASE SYSTEM
// ===============================

model Lease {
  id Int @id @default(autoincrement())

  tenantRoomId Int
  tenantRoom TenantRoom @relation(fields: [tenantRoomId], references: [id])

  rentAmount    Float
  depositAmount Float

  startDate DateTime
  endDate   DateTime?

  status LeaseStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([tenantRoomId])
}

// ===============================
// METER SYSTEM
// ===============================

model Meter {
  id Int @id @default(autoincrement())

  meterNumber String @unique

  roomId Int
  type   MeterType

  room Room @relation(fields: [roomId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings MeterReading[]

  @@index([roomId])
}

model MeterReading {
  id Int @id @default(autoincrement())

  meterId Int
  meter   Meter @relation(fields: [meterId], references: [id])

  reading Int
  readingDate DateTime

  createdAt DateTime @default(now())

  @@unique([meterId, readingDate])
}

// ===============================
// BILLING SYSTEM
// ===============================

model Invoice {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])

  leaseId Int
  lease Lease @relation(fields: [leaseId], references: [id])

  billingMonth Int
  billingYear Int

  dueDate DateTime

  subtotal Float
  totalAmount Float

  status InvoiceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]
  payments Payment[]

  @@index([tenantId, billingMonth, billingYear])
}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  description String
  amount      Float
  type        PaymentType
}

model Payment {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  amount Float

  type   PaymentType
  status PaymentStatus

  transactionId String?
  notes         String?

  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([invoiceId])
}

// ===============================
// MAINTENANCE
// ===============================

model MaintenanceRequest {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant Tenant @relation(fields: [tenantId], references: [id])

  roomId Int
  room Room @relation(fields: [roomId], references: [id])

  title String
  description String

  priority MaintenancePriority
  status MaintenanceStatus

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===============================
// ANALYTICS / DASHBOARD
// ===============================

model BuildingStats {
  id Int @id @default(autoincrement())

  buildingId Int @unique
  building   Building @relation(fields: [buildingId], references: [id])

  totalRooms     Int
  occupiedRooms  Int
  totalTenants   Int
  totalResidents Int

  updatedAt DateTime @updatedAt
}

// ===============================
// AUDIT LOG
// ===============================

model AuditLog {
  id Int @id @default(autoincrement())

  userId Int?
  action String
  entity String
  entityId Int

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
}